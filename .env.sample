# Copy to .env.local and replace the database placeholders.
# Never commit .env.local or any real secret values.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<server-side-project-key>"

# Optional deployment settings.
NEXT_PUBLIC_APP_NAME="Local Development Toolkit"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<public-project-anon-key>"

# Leave provider keys empty when testing views that do not use AI.
OPENAI_API_KEY=""
EXA_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# This flag controls unauthenticated production generation.
# Development mode permits generation regardless of this flag.
AI_GENERATION_ENABLED="false"

# Optional server authorization and cache-version settings.
# AI_ADMIN_TOKEN="<server-side-admin-token>"
# AI pipeline and cache entries default to v2 when this variable is unset.
# AI_PROMPT_VERSION="v2"
# AI_INVALIDATION_VERSION="v1"
