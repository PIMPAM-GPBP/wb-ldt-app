# Copy to .env.local and replace the database placeholders.
# Never commit .env.local or any real secret values.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<server-side-project-key>"

# Optional deployment settings.
NEXT_PUBLIC_APP_NAME="Local Development Toolkit"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<public-project-anon-key>"

# Only the planning brief scripts under scripts/ use OpenAI; leave it empty otherwise.
OPENAI_API_KEY=""
# OPENAI_MODEL="<model id>"

# Optional: keep the planning brief store on a separate Supabase branch.
# BRIEF_SUPABASE_URL="https://<branch-ref>.supabase.co"
# BRIEF_SUPABASE_SERVICE_ROLE_KEY="<branch-service-role-key>"

# Optional cache-version settings for extracted plan text; unset, they are v4 and v1.
# AI_PROMPT_VERSION="v4"
# AI_INVALIDATION_VERSION="v1"
